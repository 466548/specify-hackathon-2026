# Specify - environment variables sample
# 実際の値は .env にコピーして書く（.env はコミットしない）。

# --- OpenAI 公式（Week 1〜2 の疎通確認用） ---
OPENAI_API_KEY=

# --- Specify API 保護用（backend / frontend で共通使用） ---
SPECIFY_ANALYZE_TOKEN=

# --- Azure OpenAI（Week 3 以降に切替） ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Notion（Past PRD Agent 用） ---
NOTION_API_KEY=
